# ==========================================================================================
# Narrative Intelligence Prediction Engine — environment configuration
# Copy to .env and fill in secrets. Everything except the connection string and OpenAI key
# has a sensible default and can be omitted.
# ==========================================================================================

# --- Cosmos DB (Mongo API) — REQUIRED ---
COSMOS_MONGO_CONNECTION=mongodb+srv://BiasBreakers:h23qkDvA54H2rr4@biasbreakers-uom-mongo-cluster.global.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
# TLS: keep false normally; set true only if a local cert chain intercepts verification.
COSMOS_ALLOW_INVALID_CERTS=false
# Optional custom CA bundle (defaults to certifi).
COSMOS_TLS_CA_FILE=

# --- OpenAI (topic labels + macro-to-ticker mapping) — REQUIRED for full LLM output ---
NARRATIVE_LLM_API_KEY=
# OPENAI_API_KEY=            # alternative name; NARRATIVE_LLM_API_KEY takes precedence

# --- Databases / collections (defaults match the verified Cosmos layout) ---
NARRATIVE_NEWS_DATABASE=FinancialNewsDB
NARRATIVE_EXCLUDED_COLLECTION=Ticker_Info
NARRATIVE_TICKER_INFO_DATABASE=FinancialNewsDB
NARRATIVE_TICKER_INFO_COLLECTION=Ticker_Info
# CSE announcements are special-cased into micro views (mapped to a ticker via companyId).
NARRATIVE_CSE_COLLECTION=CSE_Annoucements
NARRATIVE_MARKET_DATABASE=SPSL20_DB
NARRATIVE_PRICE_COLLECTION=tickerdata_2020-2026
NARRATIVE_MARKETCAP_COLLECTION=marketcap_2026
NARRATIVE_INDEX_COLLECTION=sp_sl20_index

# --- Date windows ---
NARRATIVE_LOOKBACK_DAYS=30
NARRATIVE_COVARIANCE_WINDOW_TRADING_DAYS=30

# --- Narrative / Qi ---
# Leave the alpha/lambda vars UNSET to use the built-in tuned defaults (Optuna Jul30 best
# trial #32): macro alpha/lambda = 0.1675/0.7444, micro alpha/lambda = 0.1029/1.3542.
# Uncomment to override per pipeline.
# NARRATIVE_MACRO_ALPHA=0.16747222060949643
# NARRATIVE_MACRO_LAMBDA=0.744442959371803
# NARRATIVE_MICRO_ALPHA=0.10285630801219799
# NARRATIVE_MICRO_LAMBDA=1.3541701726546824

# Base min_cluster_size stays at its code default (4); it is only a fallback for a
# variant that doesn't set its own. Both pipelines set explicit config below, so
# there is no global to leak into both.
# NARRATIVE_MIN_CLUSTER_SIZE=4

# --- Macro pipeline (BERTopic) overrides ---
# Coarser, broader topics for market-wide narratives.
NARRATIVE_MACRO_MIN_CLUSTER_SIZE=20
NARRATIVE_MACRO_MIN_TOPIC_COUNT=20
NARRATIVE_MACRO_UMAP_N_NEIGHBORS=30
NARRATIVE_MACRO_UMAP_N_COMPONENTS=5
NARRATIVE_MACRO_UMAP_METRIC=cosine
NARRATIVE_MACRO_HDBSCAN_MIN_SAMPLES=5
NARRATIVE_MACRO_TOPIC_TOP_WORDS=10
NARRATIVE_MACRO_RANDOM_STATE=42

# --- Micro pipeline (BERTopic) overrides ---
# Finer, company-specific topics; small clusters.
NARRATIVE_MICRO_MIN_CLUSTER_SIZE=4
NARRATIVE_MICRO_MIN_TOPIC_COUNT=4
NARRATIVE_MICRO_UMAP_N_NEIGHBORS=15
NARRATIVE_MICRO_UMAP_N_COMPONENTS=5
NARRATIVE_MICRO_UMAP_METRIC=cosine
NARRATIVE_MICRO_HDBSCAN_MIN_SAMPLES=1
NARRATIVE_MICRO_TOPIC_TOP_WORDS=10
NARRATIVE_MICRO_RANDOM_STATE=42

# --- View calibration + BL tau (tuned defaults; set to 0/1.0/0 / empty to disable) ---
# NARRATIVE_VIEW_NEUTRAL_BAND=0.09284166734679616
# NARRATIVE_VIEW_MACRO_WEIGHT=0.7529281487215205
# NARRATIVE_VIEW_TARGET_RETURN_STD=0.002429301617990945
# NARRATIVE_BL_TAU=0.5712965167021189

# --- LLM topic labels ---
NARRATIVE_USE_LLM_TOPIC_LABELS=true
NARRATIVE_LLM_TOPIC_MODEL=gpt-4o-mini

# --- LLM macro overrides ---
NARRATIVE_USE_MACRO_OVERRIDES=true
NARRATIVE_MACRO_LLM_MODEL=gpt-4o-mini
NARRATIVE_MACRO_LLM_SEED=42
NARRATIVE_MACRO_MAX_ALLOCATIONS=20

# --- Black-Litterman ---
NARRATIVE_BL_RISK_FREE_RATE=0.05
NARRATIVE_BL_RISK_AVERSION_FALLBACK=2.5
NARRATIVE_BL_USE_VIEW_CONFIDENCE=true
NARRATIVE_BL_COVARIANCE_UNIVERSE_SIZE=20
# NARRATIVE_BL_TAU=            # omit for pypfopt default (0.05)
