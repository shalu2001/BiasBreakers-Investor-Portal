# Behavioural-simulation backend -- copy to .env and fill in.
# .env is git-ignored; never commit real credentials.

# --- Cosmos DB (Mongo API), shared BiasBreakers cluster ---------------------
# Same connection string the RL / Narrative teams use. Our data goes into
# clearly-prefixed collections (portal_users, portal_profiles) so it never
# collides with theirs.
COSMOS_MONGO_CONNECTION=mongodb+srv://BiasBreakers:<password>@biasbreakers-uom-mongo-cluster.global.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000

# The database name the team uses (ask whoever set up the cluster).
COSMOS_DATABASE=

# TLS: keep false normally. Set true only if a local cert-chain interception
# breaks verification. Optional custom CA bundle (defaults to certifi).
COSMOS_ALLOW_INVALID_CERTS=false
COSMOS_TLS_CA_FILE=

# --- Auth --------------------------------------------------------------------
# Secret used to sign JWT session tokens. Use a long random string in real use,
# e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
